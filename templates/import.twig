<div class="ngk-top-grid">
<section class="ngk-card"><h3>{{ 'NeorGoogleKeywords_ConnectionCheck'|translate }}</h3><p>{{ 'NeorGoogleKeywords_ConnectionCheckHelp'|translate }}</p>
<form method="post" action="{{ ngkPost }}"><input type="hidden" name="nonce" value="{{ ngkNonce }}"><input type="hidden" name="operation" value="test"><button type="submit" class="btn ngk-button">{{ 'NeorGoogleKeywords_TestConnection'|translate }}</button></form>
{% if ngkProperties %}<h4>{{ 'NeorGoogleKeywords_AvailableProperties'|translate }}</h4><ul class="ngk-properties">{% for property in ngkProperties %}<li><strong>{{ property.siteUrl }}</strong><br><span class="ngk-muted">{{ property.permissionLevel }}</span></li>{% endfor %}</ul>{% endif %}
<p><a href="{{ ngkSettingsUrl }}">{{ 'NeorGoogleKeywords_ConnectionInfo'|translate }}</a></p></section>
<section class="ngk-card"><h3>{{ 'NeorGoogleKeywords_ManualImport'|translate }}</h3><p>{{ 'NeorGoogleKeywords_ManualImportHelp'|translate }}</p>
<form method="post" action="{{ ngkPost }}" class="ngk-filter"><input type="hidden" name="nonce" value="{{ ngkNonce }}"><input type="hidden" name="operation" value="import">
<label>{{ 'NeorGoogleKeywords_From'|translate }} <input type="text" class="ngk-date-input" name="import_from" value="{{ ngkImportFrom }}" data-max-date="{{ ngkLatest }}" placeholder="{{ 'NeorGoogleKeywords_DateFormat'|translate }}" title="{{ 'NeorGoogleKeywords_DateFormatHint'|translate }}" pattern="[0-9]{2}-[0-9]{2}-[0-9]{4}" maxlength="10" required></label><label>{{ 'NeorGoogleKeywords_To'|translate }} <input type="text" class="ngk-date-input" name="import_to" value="{{ ngkImportTo }}" data-max-date="{{ ngkLatest }}" placeholder="{{ 'NeorGoogleKeywords_DateFormat'|translate }}" title="{{ 'NeorGoogleKeywords_DateFormatHint'|translate }}" pattern="[0-9]{2}-[0-9]{2}-[0-9]{4}" maxlength="10" required></label><button type="submit" class="btn ngk-button">{{ 'NeorGoogleKeywords_ImportAction'|translate }}</button></form>
<p class="ngk-muted">{{ 'NeorGoogleKeywords_ImportAvailableHelp'|translate(ngkLatest|date('d-m-Y')) }}</p><p><a href="{{ ngkJournalUrl }}">{{ 'NeorGoogleKeywords_ImportLog'|translate }}</a></p></section>
</div>
<section class="ngk-card"><h3>{{ 'NeorGoogleKeywords_SshImport'|translate }}</h3><p>{{ 'NeorGoogleKeywords_SshImportHelp'|translate }}</p>
<pre>php console ngk:import --idsite={{ ngkId }} --from={{ ngkFrom }} --to={{ ngkLatest }}</pre>
<p>{{ 'NeorGoogleKeywords_SchedulerHelp'|translate }}</p></section>
