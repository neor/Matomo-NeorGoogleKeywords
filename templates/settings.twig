<div class="ngk-top-grid">
<section class="ngk-card"><h3>Google Cloud settings</h3>
{% if ngkKeyError %}<div class="ngk-notice is-error">{{ ngkKeyError }}</div>{% endif %}
<dl class="ngk-settings-list"><dt>{{ 'NeorGoogleKeywords_ConnectionMethod'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_ServiceAccount'|translate }}</dd><dt>{{ 'NeorGoogleKeywords_Project'|translate }}</dt><dd>{{ ngkInfo.project ?: ('NeorGoogleKeywords_Unknown'|translate) }}</dd><dt>{{ 'NeorGoogleKeywords_ServiceAccountEmail'|translate }}</dt><dd>{{ ngkInfo.email ?: ('NeorGoogleKeywords_Unknown'|translate) }}</dd><dt>{{ 'NeorGoogleKeywords_KeyFile'|translate }}</dt><dd><code>{{ ngkInfo.file ?: ('NeorGoogleKeywords_NotSet'|translate) }}</code></dd><dt>{{ 'NeorGoogleKeywords_FileStatus'|translate }}</dt><dd>{{ ngkKeyError ? ('NeorGoogleKeywords_InvalidFile'|translate) : ('NeorGoogleKeywords_ValidFile'|translate) }}</dd><dt>{{ 'NeorGoogleKeywords_Scope'|translate }}</dt><dd><code>webmasters.readonly</code></dd></dl>
<p><a href="{{ ngkInfo.googleUrl }}" target="_blank" rel="noopener noreferrer">Google Cloud: Search Console API ↗</a></p><p class="ngk-muted">{{ 'NeorGoogleKeywords_FileStatusHelp'|translate }}</p></section>
<section class="ngk-card"><h3>NeorGoogleKeywords settings</h3>
<dl class="ngk-settings-list"><dt>{{ 'NeorGoogleKeywords_SiteId'|translate }}</dt><dd>{{ ngkId }}</dd><dt>{{ 'NeorGoogleKeywords_Property'|translate }}</dt><dd>{{ ngkProperty ?: ('NeorGoogleKeywords_NotConfigured'|translate) }}</dd><dt>{{ 'NeorGoogleKeywords_ConfigurationParameter'|translate }}</dt><dd><code>property_{{ ngkId }}</code></dd><dt>{{ 'NeorGoogleKeywords_SearchType'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_WebSearch'|translate }}</dd><dt>{{ 'NeorGoogleKeywords_LastCheck'|translate }}</dt><dd>{% if ngkInfo.connection %}{{ ngkInfo.connection.time }} UTC · {{ ngkInfo.connection.available ? ('NeorGoogleKeywords_PropertyAvailable'|translate) : ('NeorGoogleKeywords_PropertyNotFound'|translate) }}{% if ngkInfo.connection.permission %}<br>{{ ngkInfo.connection.permission }}{% endif %}{% else %}{{ 'NeorGoogleKeywords_NoConnectionCheck'|translate }}{% endif %}</dd></dl>
<p><a href="https://search.google.com/search-console/" target="_blank" rel="noopener noreferrer">{{ 'NeorGoogleKeywords_OpenSearchConsole'|translate }}</a></p><p>{{ 'NeorGoogleKeywords_PropertyAccessHelp'|translate }}</p></section>
</div>
<section class="ngk-card"><h3>{{ 'NeorGoogleKeywords_ImportStorage'|translate }}</h3><dl class="ngk-settings-list"><dt>{{ 'NeorGoogleKeywords_PluginVersion'|translate }}</dt><dd>{{ ngkVersion|default('1.1.1') }}</dd><dt>{{ 'NeorGoogleKeywords_Schedule'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_ScheduleHelp'|translate }}</dd><dt>{{ 'NeorGoogleKeywords_Delay'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_ImportDelay'|translate(ngkLatest) }}</dd><dt>{{ 'NeorGoogleKeywords_Settings'|translate }}</dt><dd><code>config/config.ini.php → [NeorGoogleKeywords]</code></dd><dt>{{ 'NeorGoogleKeywords_Data'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_StorageHelp'|translate }}</dd><dt>{{ 'NeorGoogleKeywords_Journal'|translate }}</dt><dd>{{ 'NeorGoogleKeywords_LogRetentionHelp'|translate }}</dd><dt>{{ 'NeorGoogleKeywords_CustomDesign'|translate }}</dt><dd><code>plugins/NeorGoogleKeywords/stylesheets/custom.css</code> {{ 'NeorGoogleKeywords_CustomStylesSuffix'|translate }}</dd></dl>
<p class="ngk-muted">{{ 'NeorGoogleKeywords_SettingsHelp'|translate }}</p></section>
