{% set statuses = {'info':('NeorGoogleKeywords_Info'|translate), 'success':('NeorGoogleKeywords_Success'|translate), 'warning':('NeorGoogleKeywords_Warning'|translate), 'error':('NeorGoogleKeywords_Error'|translate), 'legacy':('NeorGoogleKeywords_Legacy'|translate)} %}
{% set sources = {'web':('NeorGoogleKeywords_Manual'|translate), 'cli':'CLI', 'cron':'Cron'} %}
<form method="get" action="index.php" class="ngk-filter ngk-card">
<input type="hidden" name="module" value="NeorGoogleKeywords"><input type="hidden" name="action" value="index"><input type="hidden" name="category" value="{{ ngkCategory|default('') }}"><input type="hidden" name="subcategory" value="{{ ngkSubcategory|default('') }}"><input type="hidden" name="section" value="journal"><input type="hidden" name="idSite" value="{{ ngkId }}">
<label>{{ 'NeorGoogleKeywords_Status'|translate }}<select name="status"><option value="">{{ 'NeorGoogleKeywords_All'|translate }}</option>{% for key, label in statuses %}<option value="{{ key }}"{% if key == ngkStatus %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>{{ 'NeorGoogleKeywords_Source'|translate }}<select name="source"><option value="">{{ 'NeorGoogleKeywords_All'|translate }}</option>{% for key, label in sources %}<option value="{{ key }}"{% if key == ngkLogSource %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><button class="btn ngk-button" type="submit">{{ 'NeorGoogleKeywords_Show'|translate }}</button></form>
<p class="ngk-muted">{{ 'NeorGoogleKeywords_LogSummary'|translate(ngkLogCount) }}</p>
<section class="ngk-card"><div class="ngk-table-scroll"><table class="dataTable ngk-table ngk-log-table"><thead><tr><th>{{ 'NeorGoogleKeywords_TimeUtc'|translate }}</th><th>{{ 'NeorGoogleKeywords_Status'|translate }}</th><th>{{ 'NeorGoogleKeywords_Source'|translate }}</th><th>{{ 'NeorGoogleKeywords_EventDetails'|translate }}</th></tr></thead><tbody>
{% set fields = {'run':('NeorGoogleKeywords_Run'|translate), 'property':('NeorGoogleKeywords_Property'|translate), 'from':('NeorGoogleKeywords_PeriodStart'|translate), 'to':('NeorGoogleKeywords_PeriodEnd'|translate), 'date':('NeorGoogleKeywords_Day'|translate), 'stage':('NeorGoogleKeywords_Stage'|translate), 'days':('NeorGoogleKeywords_SavedDays'|translate), 'clicks':('NeorGoogleKeywords_Clicks'|translate), 'impressions':('NeorGoogleKeywords_Impressions'|translate), 'queries':('NeorGoogleKeywords_QueryRows'|translate), 'pages':('NeorGoogleKeywords_PageRows'|translate), 'seconds':('NeorGoogleKeywords_Seconds'|translate)} %}
{% for entry in ngkLogs %}{% set ctx = entry.context|default({}) %}{% set status = ctx.status|default('legacy') %}
<tr><td class="ngk-nowrap">{{ entry.time }}</td><td><span class="ngk-badge {{ status }}">{{ statuses[status]|default(status) }}</span></td><td>{{ sources[ctx.source|default('')]|default('—') }}</td><td><strong>{{ entry.message }}</strong>
{% if ctx %}<dl class="ngk-log-meta">{% for key, label in fields %}{% if ctx[key] is defined %}<div><dt>{{ label }}</dt><dd>{{ ctx[key] }}</dd></div>{% endif %}{% endfor %}</dl>{% endif %}</td></tr>
{% else %}<tr><td colspan="4" class="ngk-empty">{{ 'NeorGoogleKeywords_NoLogEvents'|translate }}</td></tr>{% endfor %}
</tbody></table></div>{% include '@NeorGoogleKeywords/pagination.twig' %}</section>
